{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_BUILD_WITH_INSTALL_RPATH": "ON",
        "ENABLE_COVERAGE": "ON",
        "BUILD_TESTS": "ON",
        "BUILD_GUI": "ON",
        "ENABLE_CLANG_TIDY": "ON",
        "BUILD_GUI_RUNTIME": "OFF"
      }
    },
    {
      "name": "debug-gui",
      "displayName": "Debug GUI (Ninja)",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/debug-gui",
      "cacheVariables": {
        "BUILD_GUI": "ON",
        "BUILD_GUI_RUNTIME": "OFF"
      }
    },
    {
      "name": "debug-headless",
      "displayName": "Debug Headless (Ninja)",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/debug-headless",
      "cacheVariables": {
        "BUILD_GUI": "OFF",
        "BUILD_GUI_RUNTIME": "OFF"
      }
    },
    {
      "name": "release-gui",
      "displayName": "Release GUI (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release-gui",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_BUILD_WITH_INSTALL_RPATH": "ON",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install/release-gui",
        "INSTALL_GUI": "OFF",
        "BUILD_GUI_RUNTIME": "ON",
        "ENABLE_COVERAGE": "OFF",
        "BUILD_TESTS": "ON",
        "BUILD_GUI": "ON",
        "ENABLE_CLANG_TIDY": "OFF"
      }
    },
    {
      "name": "release-headless",
      "displayName": "Release Headless (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release-headless",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_BUILD_WITH_INSTALL_RPATH": "ON",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install/release-headless",
        "ENABLE_COVERAGE": "OFF",
        "BUILD_TESTS": "ON",
        "BUILD_GUI": "OFF",
        "INSTALL_GUI": "OFF",
        "BUILD_GUI_RUNTIME": "OFF",
        "ENABLE_CLANG_TIDY": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "debug-gui",
      "configurePreset": "debug-gui"
    },
    {
      "name": "debug-headless",
      "configurePreset": "debug-headless"
    },
    {
      "name": "release-gui",
      "configurePreset": "release-gui"
    },
    {
      "name": "release-headless",
      "configurePreset": "release-headless"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-gui",
      "configurePreset": "debug-gui",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-headless",
      "configurePreset": "debug-headless",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-gui",
      "configurePreset": "release-gui",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-headless",
      "configurePreset": "release-headless",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
