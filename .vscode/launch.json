{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug im-cpp GUI",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/im-cpp",
            "args": ["gui"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug im-cpp check",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/im-cpp",
            "args": ["check", "--log-level", "DEBUG"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
