{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install build dependencies",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/install-build-dependencies.sh",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:HOME}/.local/bin:${env:PATH}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Build and test Debug",
            "type": "shell",
            "command": "cmake --preset debug && cmake --build --preset debug && ctest --preset debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build and test Release",
            "type": "shell",
            "command": "cmake --preset release && cmake --build --preset release && ctest --preset release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": ["$gcc"]
        }
    ]
}
