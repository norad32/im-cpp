set(CMAKE_PACKAGE_NAME "application")
set(DISTRIBUTION_NAME "im-cpp")
set(PROJECT_VERSION "0.1.0")
set(PROJECT_RELEASE "1")
set(PROJECT_CXX_STANDARD 23)
set(PROJECT_DESCRIPTION "C++23 starter template")
set(SPDLOG_PACKAGE_VERSION "1.17.0")
set(CLI11_PACKAGE_VERSION "2.4.2")
set(CATCH2_PACKAGE_VERSION "3.8.1")
set(PROJECT_HOMEPAGE_URL "https://github.com/norad32/im-cpp")
set(PROJECT_SOURCE_ARCHIVE_URL
    "${PROJECT_HOMEPAGE_URL}/archive/refs/tags/v${PROJECT_VERSION}.tar.gz")
set(PROJECT_LICENSE "MIT")
set(PROJECT_AUTHOR "norad32")
set(PROJECT_VENDOR "${PROJECT_AUTHOR}")
set(PROJECT_CONTACT "${PROJECT_AUTHOR}")
set(PACKAGE_SECTION "utils")
set(MINIMUM_CMAKE_VERSION 3.25)
set(MINIMUM_GCC_VERSION 14)
set(DEBIAN_STANDARDS_VERSION "4.6.2")
set(DEBIAN_COMPAT_VERSION 13)
set(DEBIAN_PACKAGE_ARCHITECTURE "any")
set(ARCH_PACKAGE_RELEASE "${PROJECT_RELEASE}")
set(ARCH_PACKAGE_ARCHITECTURES "'x86_64' 'aarch64'")
set(EXECUTABLE_NAME "${DISTRIBUTION_NAME}")
set(GUI_EXECUTABLE_NAME "${EXECUTABLE_NAME}-gui")
set(GUI_PACKAGE_NAME "${DISTRIBUTION_NAME}-gui")
set(DEBIAN_RUNTIME_PACKAGE_NAME "${DISTRIBUTION_NAME}")
set(DEBIAN_GUI_PACKAGE_NAME "${GUI_PACKAGE_NAME}")
set(DEBIAN_DEVELOPMENT_PACKAGE_NAME "${DISTRIBUTION_NAME}-dev")
set(DEBIAN_PACKAGE_NAME "${DEBIAN_RUNTIME_PACKAGE_NAME}")
set(ARCH_RUNTIME_PACKAGE_NAME "${DISTRIBUTION_NAME}")
set(ARCH_GUI_PACKAGE_NAME "${GUI_PACKAGE_NAME}")
set(ARCH_DEVELOPMENT_PACKAGE_NAME "${DISTRIBUTION_NAME}-devel")
set(DEBIAN_BUILD_DEPENDENCIES
    "debhelper-compat (= ${DEBIAN_COMPAT_VERSION}), cmake (>= ${MINIMUM_CMAKE_VERSION}), g++ (>= ${MINIMUM_GCC_VERSION}), libglfw3-dev, libgl1-mesa-dev, ninja-build, pkg-config"
)
set(DEBIAN_GUI_RUNTIME_DEPENDENCIES "libglfw3, libgl1")
set(DEBIAN_GUI_PACKAGE_DEPENDENCIES
    "${DEBIAN_RUNTIME_PACKAGE_NAME} (= \${binary:Version}), ${DEBIAN_GUI_RUNTIME_DEPENDENCIES}"
)
set(DEBIAN_DEVELOPMENT_PACKAGE_DEPENDENCIES
    "\${misc:Depends}, ${DEBIAN_RUNTIME_PACKAGE_NAME} (= \${binary:Version}), ${DEBIAN_GUI_PACKAGE_NAME} (= \${binary:Version})"
)
set(ARCH_BUILD_DEPENDENCIES
    "'cmake>=${MINIMUM_CMAKE_VERSION}' 'gcc>=${MINIMUM_GCC_VERSION}' 'ninja' 'pkgconf' 'glfw' 'mesa'"
)
set(ARCH_GUI_PACKAGE_DEPENDENCIES
    "'${ARCH_RUNTIME_PACKAGE_NAME}' 'glfw' 'mesa'")
set(ARCH_DEVELOPMENT_PACKAGE_DEPENDENCIES
    "'${ARCH_RUNTIME_PACKAGE_NAME}' '${ARCH_GUI_PACKAGE_NAME}'")
set(RUNTIME_PACKAGE_DESCRIPTION "${PROJECT_DESCRIPTION} runtime")
set(RUNTIME_PACKAGE_LONG_DESCRIPTION
    "Command-line application for ${DISTRIBUTION_NAME}.")
set(GUI_PACKAGE_DESCRIPTION "GUI runtime for ${DISTRIBUTION_NAME}")
set(GUI_PACKAGE_LONG_DESCRIPTION
    "Graphical desktop executable for ${DISTRIBUTION_NAME}.")
set(DEVELOPMENT_PACKAGE_DESCRIPTION
    "Development files for ${DISTRIBUTION_NAME}")
set(DEVELOPMENT_PACKAGE_LONG_DESCRIPTION
    "Headers, static libraries, and CMake exports for ${DISTRIBUTION_NAME}.")
set(METADATA_INCLUDE_DIR "core")
set(PACKAGE_NAMESPACE "${CMAKE_PACKAGE_NAME}::")
