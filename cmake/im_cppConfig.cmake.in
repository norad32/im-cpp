@PACKAGE_INIT@

set(_IM_CPP_PACKAGE_NAME "@IM_CPP_CMAKE_PACKAGE_NAME@")

include(CMakeFindDependencyMacro)
find_dependency(
    spdlog
    1.17.0
    EXACT
    CONFIG)
set(${_IM_CPP_PACKAGE_NAME}_app_FOUND TRUE)
set(${_IM_CPP_PACKAGE_NAME}_development_FOUND TRUE)
if(@IM_CPP_BUILD_GUI@)
    set(${_IM_CPP_PACKAGE_NAME}_gui_FOUND TRUE)
    find_dependency(OpenGL)
    find_dependency(glfw3 CONFIG)
    if(NOT TARGET glfw)
        find_dependency(PkgConfig)
        pkg_check_modules(
            GLFW3
            REQUIRED
            IMPORTED_TARGET
            glfw3)
        add_library(glfw ALIAS PkgConfig::GLFW3)
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/@IM_CPP_CMAKE_PACKAGE_NAME@Targets.cmake")
check_required_components("${_IM_CPP_PACKAGE_NAME}")
unset(_IM_CPP_PACKAGE_NAME)
