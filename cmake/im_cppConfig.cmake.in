@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(
    spdlog
    1.17.0
    EXACT
    CONFIG)
set(im_cpp_app_FOUND TRUE)
set(im_cpp_development_FOUND TRUE)
if(@IM_CPP_BUILD_GUI@)
    set(im_cpp_gui_FOUND TRUE)
    find_dependency(OpenGL)
    find_dependency(glfw3 CONFIG)
    if(NOT TARGET glfw)
        find_dependency(PkgConfig)
        pkg_check_modules(
            GLFW3
            REQUIRED
            IMPORTED_TARGET
            glfw3)
        add_library(glfw ALIAS PkgConfig::GLFW3)
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/im_cppTargets.cmake")
check_required_components(im_cpp)
